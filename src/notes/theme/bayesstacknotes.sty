  {\fontsize{9}{11}\selectfont\color{BayesTeal}\MakeUppercase{\chaptertitlename}\ \thechapter}
  {3pt}
  {\fontsize{22}{25}\selectfont\filright}
  [\vspace{5pt}{\color{BayesBorder}\titlerule[0.6pt]}]
\titlespacing*{\chapter}{0pt}{0pt}{14pt}

\titleformat{name=\chapter,numberless}[display]
  {\normalfont\BayesDisplayFont\bfseries\color{BayesInk}}
  {}
  {0pt}
  {\fontsize{22}{25}\selectfont\filright}
  [\vspace{5pt}{\color{BayesBorder}\titlerule[0.6pt]}]
\titlespacing*{name=\chapter,numberless}{0pt}{0pt}{14pt}

\titleformat{\part}[display]

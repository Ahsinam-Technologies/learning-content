% Chapter Opener compatibility macro
\newcommand{\BayesChapterOpenerContent}[4]{%
  \BayesCaptureAssetRoot
  \begin{minipage}{\linewidth}
    \vspace*{0.15cm}
    {\raggedright
      \begin{tikzpicture}
        \node[fill=BayesDark,rounded corners=2.0pt,inner xsep=8pt,inner ysep=3.5pt] {
          {\BayesDisplayFont\bfseries\color{BayesPale}\small CHAPTER #1}
        };
      \end{tikzpicture}
      \par\vspace{0.30cm}
      {\BayesDisplayFont\fontsize{22}{25}\selectfont\bfseries\color{BayesInk}#2\par}
      \vspace{0.18cm}
      {\large\color{BayesSecondary}#3\par}
      \vspace{0.30cm}
      {\color{BayesTeal}\rule{2.2cm}{1.8pt}}\textcolor{BayesBorder}{\rule{\dimexpr\linewidth-2.2cm\relax}{0.4pt}}\par\vspace{0.35cm}
    }
    \ifstrempty{#4}{}{%
      \chapterpurpose{#4}%
    }
  \end{minipage}
}

\newcommand{\ChapterOpener}[4]{%
  \refstepcounter{chapter}%
  \chaptermark{#2}%
  \phantomsection
  \addcontentsline{toc}{chapter}{\protect\numberline{\thechapter}#2}%
  \if@twocolumn
    \clearpage
    \twocolumn[{%
      \BayesChapterOpenerContent{#1}{#2}{#3}{#4}%
      \vspace{1.0em}%
    }]%
  \else
    \clearpage
    \BayesChapterOpenerContent{#1}{#2}{#3}{#4}%
    \vspace{1.0em}%
  \fi
  \markboth{\thechapter\quad #2}{\thechapter\quad #2}%
}


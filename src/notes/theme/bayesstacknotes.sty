% --- Essential Engine & Font System ---
\RequirePackage{iftex}
\ifPDFTeX
  \RequirePackage[utf8]{inputenc}
  \RequirePackage[T1]{fontenc}
  \RequirePackage[scaled=.96]{helvet}
  \newcommand\BayesDisplayFont{\sffamily}
\else
  \RequirePackage{fontspec}
  % Load fonts with fallback search paths
  \IfFileExists{src/core/fonts/Inter-Regular.ttf}{%
    \setmainfont[Path=src/core/fonts/,UprightFont=Inter-Regular.ttf,BoldFont=Inter-SemiBold.ttf]{Inter}%
    \setsansfont[Path=src/core/fonts/,UprightFont=Inter-Regular.ttf,BoldFont=Inter-SemiBold.ttf]{Inter}%
  }{%
    \IfFileExists{core/fonts/Inter-Regular.ttf}{%
      \setmainfont[Path=core/fonts/,UprightFont=Inter-Regular.ttf,BoldFont=Inter-SemiBold.ttf]{Inter}%
      \setsansfont[Path=core/fonts/,UprightFont=Inter-Regular.ttf,BoldFont=Inter-SemiBold.ttf]{Inter}%
    }{%
      \IfFileExists{fonts/Inter-Regular.ttf}{%
        \setmainfont[Path=fonts/,UprightFont=Inter-Regular.ttf,BoldFont=Inter-SemiBold.ttf]{Inter}%
        \setsansfont[Path=fonts/,UprightFont=Inter-Regular.ttf,BoldFont=Inter-SemiBold.ttf]{Inter}%
      }{%
        \IfFontExistsTF{Inter}{%
          \setmainfont{Inter}\setsansfont{Inter}%
        }{%
          \setmainfont{TeX Gyre Heros}\setsansfont{TeX Gyre Heros}%
        }%
      }%
    }%
  }
  \IfFileExists{src/core/fonts/Outfit-Regular.ttf}{%
    \newfontfamily\BayesDisplayFont[Path=src/core/fonts/,UprightFont=Outfit-Regular.ttf,BoldFont=Outfit-SemiBold.ttf]{Outfit}%
  }{%
    \IfFileExists{core/fonts/Outfit-Regular.ttf}{%
      \newfontfamily\BayesDisplayFont[Path=core/fonts/,UprightFont=Outfit-Regular.ttf,BoldFont=Outfit-SemiBold.ttf]{Outfit}%
    }{%
      \IfFileExists{fonts/Outfit-Regular.ttf}{%
        \newfontfamily\BayesDisplayFont[Path=fonts/,UprightFont=Outfit-Regular.ttf,BoldFont=Outfit-SemiBold.ttf]{Outfit}%
      }{\IfFontExistsTF{Outfit}{\newfontfamily\BayesDisplayFont{Outfit}}{\let\BayesDisplayFont\sffamily}}
    }%
  }
  \IfFontExistsTF{JetBrains Mono}{%
    \setmonofont[Scale=0.88]{JetBrains Mono}%
  }{%
    \IfFontExistsTF{Liberation Mono}{%
      \setmonofont[Scale=0.88]{Liberation Mono}%
    }{%
      \IfFontExistsTF{DejaVu Sans Mono}{%
        \setmonofont[Scale=0.88]{DejaVu Sans Mono}%
      }{}%
    }%
  }
\fi


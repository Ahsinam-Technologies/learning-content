% bayesstacknotes.sty — publication-ready book & reading notes system for BayesStack tenant institutions.
% Inspired by the thermal_engg_interviews professional publication book architecture.
% Adheres strictly to the BayesStack mint-and-teal design system, typography, and letterpaper geometry.
\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{bayesstacknotes}[2026/09/14 Shared BayesStack publication-ready book package]

% --- Package Options ---
\newif\ifBayesScience
\DeclareOption{science}{\BayesSciencetrue}

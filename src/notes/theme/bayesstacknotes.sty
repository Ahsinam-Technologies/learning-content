  bayesbox/.style={
    enhanced,
    breakable,
    boxrule=0.55pt,
    arc=1.5pt,
    outer arc=1.5pt,
    left=6pt,
    right=6pt,
    top=4pt,
    bottom=4pt,
    before skip=6pt plus 1pt minus 1pt,
    after skip=6pt plus 1pt minus 1pt,
    fontupper=\small,
    fonttitle=\BayesDisplayFont\bfseries\small,
    colback=white,
    colframe=BayesInk,
    colbacktitle=BayesCanvas,
    coltitle=BayesInk,
    toptitle=2.5pt,
    bottomtitle=2.5pt,
    lefttitle=5pt,
    righttitle=5pt
  }
}


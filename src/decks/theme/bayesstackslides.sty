% Lecture slides are viewed at distance.  Do not allow TeX to insert
% discretionary word breaks that make a line look unfinished or dilute its
% reading rhythm.  A modest emergency stretch keeps the resulting paragraphs
% from producing avoidable overfull boxes.
\hyphenpenalty=10000
\exhyphenpenalty=10000
\pretolerance=10000
\tolerance=2000
\emergencystretch=1.5em

\ifBayesScience
  \RequirePackage{siunitx}
  \RequirePackage{physics}
  \RequirePackage[version=4]{mhchem}
  \RequirePackage{chemfig}
  \RequirePackage{circuitikz}
  \RequirePackage{tikz-3dplot}
  \RequirePackage{braket}
  \RequirePackage{quantikz}
  \sisetup{detect-all,output-decimal-marker={.}}
\fi


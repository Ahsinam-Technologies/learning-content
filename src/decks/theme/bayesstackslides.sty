% -----------------------------------------------------------------------------
% Rigorous Mathematical Derivation Card
% -----------------------------------------------------------------------------
\newcommand{\MathDerivationStep}[4]{%
  \begin{tcolorbox}[enhanced,arc=1.8mm,boxrule=.45pt,colback=BayesSurface,colframe=BayesBorder,
    borderline west={2.5pt}{0pt}{BayesDeepTeal},left=3.4mm,right=3.4mm,top=2.0mm,bottom=2.0mm]
    \begin{columns}[c,onlytextwidth]%
      \begin{column}{.56\textwidth}%
        \tcbox[on line,boxsep=0pt,left=4pt,right=4pt,top=1.5pt,bottom=1.5pt,colback=BayesPale,colframe=BayesTeal,arc=1.2mm]{%
          \tiny\bfseries\color{BayesTeal}STEP #1\enspace\textbar\enspace#2%
        }\par\vspace{.12cm}%
        \tcbox[boxsep=3pt,colback=BayesPale!70!white,colframe=BayesBorder,arc=1.2mm,width=\linewidth]{%
          \normalsize\(\displaystyle #3\)%
        }%
      \end{column}%
      \begin{column}{.40\textwidth}%
        {\small\bfseries\color{BayesInk}Analytical Invariant}\par\vspace{.06cm}
        {\footnotesize\color{BayesSecondary}#4}

\makeatletter
\lst@Key{numbers}{none}{%
  \def\lst@PlaceNumber{\lst@linebgrd}%
  \lstKV@SwitchCases{#1}{%
    none:\\%
    left:\def\lst@PlaceNumber{\llap{\normalfont\lst@numberstyle{\thelstnumber}\kern\lst@numbersep}\lst@linebgrd}\\%
    right:\def\lst@PlaceNumber{\rlap{\normalfont\kern\linewidth\kern\lst@numbersep\lst@numberstyle{\thelstnumber}}\lst@linebgrd}%
  }{\PackageError{Listings}{Numbers #1 unknown}\@ehc}}%
\lst@Key{linebackgroundcolor}{}{\def\lst@linebgrdcolor{#1}}
\lst@Key{linebackgroundsep}{0pt}{\def\lst@linebgrdsep{#1}}
\lst@Key{linebackgroundwidth}{\linewidth}{\def\lst@linebgrdwidth{#1}}
\lst@Key{linebackgroundheight}{\ht\strutbox}{\def\lst@linebgrdheight{#1}}
\lst@Key{linebackgrounddepth}{\dp\strutbox}{\def\lst@linebgrddepth{#1}}
\lst@Key{linebackgroundcmd}{\color@block}{\def\lst@linebgrdcmd{#1}}
\newcommand{\lst@linebgrd}{\ifx\lst@linebgrdcolor\empty\else\rlap{\lst@basicstyle\color{-.}\lst@linebgrdcolor{\kern-\dimexpr\lst@linebgrdsep\relax\lst@linebgrdcmd{\lst@linebgrdwidth}{\lst@linebgrdheight}{\lst@linebgrddepth}}}\fi}
\makeatother
\lstdefinelanguage{JSON}{morestring=[b]",morecomment=[l]{//},morekeywords={true,false,null}}
\lstdefinelanguage{YAML}{sensitive=false,morecomment=[l]{\#},morestring=[b]",morekeywords={true,false,yes,no,null}}
\lstdefinestyle{BayesCode}{%
  backgroundcolor=\color{BayesCode},basicstyle=\ttfamily\footnotesize\color{BayesInk},
  commentstyle=\color{BayesSecondary},keywordstyle=\bfseries\color{BayesTeal},stringstyle=\color{BayesPlum},
  frame=single,framerule=.35pt,rulecolor=\color{BayesBorder},framesep=4pt,
  % Legacy direct-listings style retained for backwards-compatible custom use.
  breaklines=true,breakatwhitespace=false,breakautoindent=true,breakindent=1.2em,
  columns=fullflexible,keepspaces=true,showstringspaces=false,tabsize=2,numberblanklines=false,
  % Reserve a framed left gutter: numbers stay inside the code container and
  % cannot collide with a neighbouring column or callout.
  numbers=left,numberstyle=\tiny\color{BayesSecondary},numbersep=2.5pt,
  xleftmargin=1.7em,framexleftmargin=1.7em,linebackgroundcolor={\BayesLineBackground}}
\newcommand{\BayesHighlightedLines}{}
\makeatletter
\newcommand{\BayesLineBackground}{\color{BayesCode}\def\BayesLineMatch{0}\@for\BayesLineCandidate:=\BayesHighlightedLines\do{\ifnum\value{lstnumber}=\BayesLineCandidate\relax\def\BayesLineMatch{1}\fi}\ifnum\BayesLineMatch=1\color{BayesCodeHighlight}\fi}
\makeatother
% fvextra carries the final presentation renderer.  Unlike listings, its
% wrapping is reliable inside Beamer columns: a wrapped visual fragment keeps
% the original source number, leaves its continuation gutter empty, and uses
% the source indentation plus the configured two-space offset.
\newcommand{\BayesRenderCodeFile}[2]{%
  \begin{tcolorbox}[enhanced,boxrule=.35pt,colback=BayesCode,colframe=BayesBorder,
    boxsep=0pt,left=4pt,right=4pt,top=4pt,bottom=4pt,arc=0pt]
    \renewcommand{\theFancyVerbLine}{{\tiny\color{BayesSecondary}\arabic{FancyVerbLine}}}%
    \VerbatimInput[fontsize=\footnotesize,numbers=left,numbersep=2pt,
      xleftmargin=1.2em,breaklines=true,breakanywhere=true,breakautoindent=true,breakindent=1.2em,
      breaksymbolleft={},breaksymbolright={},highlightlines={#1},highlightcolor=BayesCodeHighlight]{#2}%
  \end{tcolorbox}%
}
\newenvironment{CodeBlock}[2][]{%
  \gdef\BayesCodeHighlightedLines{}%
  \VerbatimEnvironment\begin{VerbatimOut}{\jobname-bayes-code.tmp}%
}{\end{VerbatimOut}\BayesRenderCodeFile{\BayesCodeHighlightedLines}{\jobname-bayes-code.tmp}}
\newenvironment{HighlightedCodeBlock}[3][]{%
  \gdef\BayesCodeHighlightedLines{#3}%
  \VerbatimEnvironment\begin{VerbatimOut}{\jobname-bayes-code.tmp}%
}{\end{VerbatimOut}\BayesRenderCodeFile{\BayesCodeHighlightedLines}{\jobname-bayes-code.tmp}}

% bayesstackslides.sty — Bayes Academic Editorial Presentation Engine (BayesStack 2.0).
% Distinct from enterprise consulting: authoritative academic gravitas, crisp white canvas,
% restrained typography, zero UI badge clutter, dominant figures, and blackboard math clarity.
\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{bayesstackslides}[2026/09/14 Bayes Academic Editorial Slide Engine]

\newif\ifBayesScience
\DeclareOption{science}{\BayesSciencetrue}
\newif\ifBayesDebugOpt
\DeclareOption{debug}{\BayesDebugOpttrue}
\ProcessOptions\relax

\RequirePackage{iftex}
\ifPDFTeX
  \RequirePackage[utf8]{inputenc}
  \RequirePackage[T1]{fontenc}
  \RequirePackage[scaled=.96]{helvet}
\else
  \RequirePackage{fontspec}
  % Multi-path discovery for versioned TTF font assets
  \newcommand{\BayesFontPath}{}
  \IfFileExists{../../core/fonts/Inter-Regular.ttf}{\gdef\BayesFontPath{../../core/fonts/}}{%
  \IfFileExists{../../src/core/fonts/Inter-Regular.ttf}{\gdef\BayesFontPath{../../src/core/fonts/}}{%
  \IfFileExists{../../../../src/core/fonts/Inter-Regular.ttf}{\gdef\BayesFontPath{../../../../src/core/fonts/}}{%
  \IfFileExists{../../../src/core/fonts/Inter-Regular.ttf}{\gdef\BayesFontPath{../../../src/core/fonts/}}{%
  \IfFileExists{src/core/fonts/Inter-Regular.ttf}{\gdef\BayesFontPath{src/core/fonts/}}{%
  \IfFileExists{core/fonts/Inter-Regular.ttf}{\gdef\BayesFontPath{core/fonts/}}{%
  \IfFileExists{../../../../../src/core/fonts/Inter-Regular.ttf}{\gdef\BayesFontPath{../../../../../src/core/fonts/}}{%
  \IfFileExists{./Inter-Regular.ttf}{\gdef\BayesFontPath{./}}{%
  }}}}}}}}

  \ifx\BayesFontPath\empty
    \IfFontExistsTF{Inter}{%
      \setsansfont[UprightFont=* Regular,BoldFont=* SemiBold]{Inter}%
    }{\setsansfont{TeX Gyre Heros}}
    \IfFontExistsTF{Outfit}{%
      \newfontfamily\BayesDisplayFont[UprightFont=* Regular,BoldFont=* SemiBold]{Outfit}%
    }{\newfontfamily\BayesDisplayFont{TeX Gyre Heros}}
  \else
    \setsansfont[Path=\BayesFontPath,UprightFont=Inter-Regular.ttf,BoldFont=Inter-SemiBold.ttf]{Inter}
    \newfontfamily\BayesDisplayFont[Path=\BayesFontPath,UprightFont=Outfit-Regular.ttf,BoldFont=Outfit-SemiBold.ttf]{Outfit}
  \fi
\fi
\ifPDFTeX\newcommand\BayesDisplayFont{\sffamily}\fi


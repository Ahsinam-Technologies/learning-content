\newcommand{\PillBadge}[2][BayesTeal]{%
  \tcbox[on line,boxsep=0pt,left=4.5pt,right=4.5pt,top=1.5pt,bottom=1.5pt,
    colback=#1!12!white,colframe=#1!35!white,arc=0.8mm,boxrule=0.4pt]{%
    \fontsize{6.5}{7.5}\selectfont\bfseries\color{#1}#2%
  }%
}
\newcommand{\Tag}[2][BayesTeal]{\PillBadge[#1]{#2}}
\newcommand{\MetaTag}[2][BayesTeal]{\PillBadge[#1]{#2}}

\newcommand{\DataProvenance}[2][VERIFIED CLAIM]{%
  \tcbox[on line,boxsep=0pt,left=4.5pt,right=4.5pt,top=1.5pt,bottom=1.5pt,
    colback=BayesPale,colframe=BayesBorder,arc=0.8mm,boxrule=0.4pt]{%
    \fontsize{7}{8.5}\selectfont\bfseries\color{BayesSecondary}#1:\enspace\color{BayesTeal}#2%
  }%
}

% -----------------------------------------------------------------------------
% Mathematical Derivation & Blackboard Clarity Primitives
% -----------------------------------------------------------------------------
\newcommand{\MathHero}[2]{%
  \begin{center}
    \vspace{.08cm}
    {\Huge\(\displaystyle #1\)}\par\vspace{.16cm}
    {\small\color{BayesSecondary}#2}
  \end{center}%
}

\newcommand{\ChalkboardHero}[2]{%
  \begin{center}%
    \vspace{.08cm}%
    {\fontsize{18}{23}\selectfont\(\displaystyle #1\)}\par\vspace{.18cm}%
    {\normalsize\color{BayesSecondary}#2}%
  \end{center}%
}

\newcommand{\AnnotatedStep}[4]{%
  \begin{columns}[c,onlytextwidth]%
    \begin{column}{.09\textwidth}%
      \tcbox[on line,boxsep=0pt,left=3.5pt,right=3.5pt,top=1.5pt,bottom=1.5pt,colback=BayesDark,colframe=BayesDark,arc=0.8mm]{%
        \fontsize{6.5}{7.5}\selectfont\bfseries\color{white}STEP #1%
      }%
    \end{column}%
    \begin{column}{.56\textwidth}%
      \centering\normalsize\(\displaystyle #3\)%
    \end{column}%
    \begin{column}{.33\textwidth}%
      \ifstrempty{#2}{}{{\small\bfseries\color{BayesInk}#2}\par\vspace{.02cm}}%
      {\scriptsize\color{BayesSecondary}#4}%
    \end{column}%
  \end{columns}%
}

\newcommand{\MathDerivationStep}[4]{%
  \begin{tcolorbox}[enhanced,arc=1.2mm,boxrule=.4pt,colback=white,colframe=BayesBorder,
    left=3.4mm,right=3.4mm,top=2.4mm,bottom=2.4mm]
    \begin{columns}[c,onlytextwidth]%
      \begin{column}{.09\textwidth}%
        \tcbox[on line,boxsep=0pt,left=3.5pt,right=3.5pt,top=1.5pt,bottom=1.5pt,colback=BayesTeal,colframe=BayesTeal,arc=0.8mm]{%
          \fontsize{6.5}{7.5}\selectfont\bfseries\color{white}STEP #1%
        }%
      \end{column}%
      \begin{column}{.57\textwidth}%
        \centering\normalsize\(\displaystyle #3\)%
      \end{column}%
      \begin{column}{.32\textwidth}%
        \ifstrempty{#2}{}{{\small\bfseries\color{BayesInk}#2}\par\vspace{.03cm}}%
        {\scriptsize\color{BayesSecondary}#4}%
      \end{column}%
    \end{columns}%
  \end{tcolorbox}%
}


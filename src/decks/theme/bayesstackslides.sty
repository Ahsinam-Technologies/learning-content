% -----------------------------------------------------------------------------
% Restrained Academic Header & Minimal Receding Footer
% -----------------------------------------------------------------------------
\setbeamertemplate{frametitle}{%
  \nointerlineskip%
  \begin{beamercolorbox}[wd=\paperwidth,leftskip=.78cm,rightskip=.78cm]{frametitle}%
    \setlength{\parskip}{0pt}%
    % Keep the title comfortably inside the page while visually coupling it
    % to its rule.  The old spacing left the title stranded between the edge
    % and rule on projection.
    % A real zero-width strut (rather than leading \vspace) survives Beamer's
    % frame-title packing and gives the title a reliable top inset.
    \leavevmode\rule{0pt}{3mm}\par
    {\sffamily\fontsize{14}{15}\selectfont\bfseries\color{BayesInk}\strut\insertframetitle}\par\vspace{-.25cm}%
    \textcolor{BayesTeal}{\rule{1.00cm}{1.8pt}}\textcolor{BayesBorder}{\rule{\dimexpr\textwidth-1.00cm\relax}{0.4pt}}\par\vspace{.035cm}%
  \end{beamercolorbox}%
}

\setbeamertemplate{footline}{%
  \leavevmode\hbox{%
    \begin{beamercolorbox}[wd=.85\paperwidth,ht=.28cm,dp=.08cm,leftskip=.78cm]{author in head/foot}%
      \fontsize{7.5}{9}\selectfont\color{BayesMuted}%
      \ifstrempty{\BayesCourseCode}{}{\textbf{\color{BayesSecondary}\BayesCourseCode}\enspace{\color{BayesBorder}\textbullet}\enspace}%
      \BayesCourseName\ifstrempty{\BayesDeckScope}{}{\enspace{\color{BayesBorder}\textbullet}\enspace\color{BayesSecondary}\BayesDeckScope}%
    \end{beamercolorbox}%
    \begin{beamercolorbox}[wd=.15\paperwidth,ht=.28cm,dp=.08cm,rightskip=.78cm plus1fill]{date in head/foot}%
      \hfill%
      \fontsize{7.5}{9}\selectfont\color{BayesMuted}\insertframenumber\,/\,\inserttotalframenumber%
    \end{beamercolorbox}%
  }\vskip.05cm%
}

% -----------------------------------------------------------------------------
% Title Pages & Section Dividers (High-Contrast, Academic Gravitas)
% -----------------------------------------------------------------------------
\setbeamercolor{title page}{bg=BayesDark}
\setbeamertemplate{title page}{%
  \begin{beamercolorbox}[wd=\paperwidth,ht=\paperheight,sep=0pt]{title page}%
    \begin{tikzpicture}[remember picture,overlay]
      \fill[BayesTeal] (current page.north west) rectangle ([xshift=.20cm]current page.south west);
      \draw[BayesSecondary!30!BayesDark,line width=.4pt] ([xshift=14.5cm,yshift=-.78cm]current page.north west) -- ([xshift=14.5cm,yshift=-7.00cm]current page.north west);
      \fill[BayesTeal] ([xshift=14.5cm,yshift=-6.95cm]current page.north west) rectangle ([xshift=15.65cm,yshift=-7.00cm]current page.north west);
    \end{tikzpicture}%
    \vspace*{.68cm}\hspace*{.78cm}{\BayesDisplayFont\fontsize{13}{15}\selectfont\bfseries\color{white}Bayes\textcolor{BayesTeal}{Stack}\enspace\textcolor{BayesSecondary}{\textbar}\enspace\color{BayesBorder}Advanced Curriculum System}
    \vfill
    \hspace*{.78cm}{\color{BayesTeal}\rule{1.20cm}{2.4pt}}\par\vspace{.32cm}
    \hspace*{.78cm}\begin{minipage}{.76\paperwidth}\raggedright
      {\BayesDisplayFont\fontsize{25}{30}\selectfont\bfseries\color{white}\inserttitle\par}
      \vspace{.28cm}{\large\color{BayesBorder}\insertsubtitle\par}
      \ifstrempty{\BayesCourseCode}{}{%
        \vspace{.36cm}%
        \tcbox[on line,boxsep=0pt,left=5pt,right=5pt,top=2.0pt,bottom=2.0pt,colback=BayesDeepTeal,colframe=BayesTeal,arc=1.0mm]{%
          \footnotesize\bfseries\color{white}\BayesCourseCode%
        }%
      }\par
    \end{minipage}\par\vspace{.36cm}%
    \vfill
    \hspace*{.78cm}{\scriptsize\color{BayesMuted}BayesStack Computational \& Theoretical Intelligence Series}\vspace*{.54cm}
  \end{beamercolorbox}%
}
\newcommand{\BayesCourseTitleSlide}[2]{\title{#1}\subtitle{#2}\begin{frame}[plain]\titlepage\end{frame}}

\newcommand{\SessionEntry}[3]{\item[]\textbf{\color{BayesTeal}#1}\hspace{.4em}\textbf{#2}\par\scriptsize\color{BayesSecondary}#3\normalsize\vspace{.10cm}}
\newcommand{\TopicEntry}[3]{\item[]\textbf{\color{BayesTeal}#1}\hspace{.4em}\textbf{#2}\par\scriptsize\color{BayesSecondary}#3\normalsize\vspace{.10cm}}
\newcommand{\CourseSessionMapSlide}[1]{%
  \begin{frame}{Course Curriculum Roadmap}\footnotesize\begin{enumerate}\setlength{\itemsep}{.06cm}#1\end{enumerate}\vfill\BayesCaption{Integrated academic sequence structured for theoretical rigor and computational execution.}\end{frame}%
}
\newcommand{\SessionTopicMapSlide}[1]{%
  \begin{frame}{Session Modular Agenda}\footnotesize\begin{enumerate}\setlength{\itemsep}{.06cm}#1\end{enumerate}\vfill\BayesCaption{Topic units sequence in-class lectures, mathematical derivations, and implementation.}\end{frame}%
}

\newcommand{\SessionDivider}[3]{%
  \BayesCaptureAssetRoot
  {\setbeamercolor{background canvas}{bg=BayesDark}%
  \begin{frame}[plain]
    \vspace*{.72cm}\hspace*{.78cm}{\sffamily\color{BayesTeal}\bfseries\large SESSION\enspace#1}\par
    \vfill\hspace*{.78cm}\begin{minipage}{.80\paperwidth}\raggedright
      {\BayesDisplayFont\fontsize{27}{32}\selectfont\bfseries\color{white}#2\par}\vspace{.26cm}
      {\large\color{BayesBorder}#3\par}
    \end{minipage}\vfill
    \hspace*{.78cm}{\scriptsize\color{BayesMuted}\BayesCourseCode\ifstrempty{\BayesCourseName}{}{\enspace\textbar\enspace\BayesCourseName}}\vspace*{.58cm}
  \end{frame}}%
}

\newcommand{\TopicDivider}[3]{%
  \BayesCaptureAssetRoot
  {\setbeamercolor{background canvas}{bg=BayesCanvas}%
  \begin{frame}[plain]
    \vspace*{.82cm}\hspace*{.78cm}{\sffamily\color{BayesTeal}\bfseries\large TOPIC\enspace#1}\par
    \vfill\hspace*{.78cm}\begin{minipage}{.78\paperwidth}\raggedright
      {\BayesDisplayFont\fontsize{26}{31}\selectfont\bfseries\color{BayesInk}#2\par}\vspace{.24cm}
      {\large\color{BayesSecondary}#3\par}
    \end{minipage}\vfill
    \hspace*{.78cm}{\color{BayesTeal}\rule{1.20cm}{2.0pt}}\vspace*{.68cm}
  \end{frame}}%
}

% Subfiles standalone compatibility
\newcommand{\SessionStandaloneTitle}[3]{%
  \ifSubfilesClassLoaded{\title{#2}\subtitle{#3}\gdef\BayesDeckScope{Session #1}\begin{frame}[plain]\titlepage\end{frame}}{}%
}
\newcommand{\TopicStandaloneTitle}[3]{%
  \ifSubfilesClassLoaded{\title{#2}\subtitle{#3}\gdef\BayesDeckScope{Topic #1}\begin{frame}[plain]\titlepage\end{frame}}{}%
}


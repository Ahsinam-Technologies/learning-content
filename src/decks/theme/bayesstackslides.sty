% Source-safe code blocks; no shell escape is required.
\makeatletter
\lst@Key{numbers}{none}{%
  \def\lst@PlaceNumber{\lst@linebgrd}%
  \lstKV@SwitchCases{#1}{%
    none:\\%
    left:\def\lst@PlaceNumber{\llap{\normalfont\lst@numberstyle{\thelstnumber}\kern\lst@numbersep}\lst@linebgrd}\\%
    right:\def\lst@PlaceNumber{\rlap{\normalfont\kern\linewidth\kern\lst@numbersep\lst@numberstyle{\thelstnumber}}\lst@linebgrd}%
  }{\PackageError{Listings}{Numbers #1 unknown}\@ehc}}%
\lst@Key{linebackgroundcolor}{}{\def\lst@linebgrdcolor{#1}}
\lst@Key{linebackgroundsep}{0pt}{\def\lst@linebgrdsep{#1}}
\lst@Key{linebackgroundwidth}{\linewidth}{\def\lst@linebgrdwidth{#1}}
\lst@Key{linebackgroundheight}{\ht\strutbox}{\def\lst@linebgrdheight{#1}}
\lst@Key{linebackgrounddepth}{\dp\strutbox}{\def\lst@linebgrddepth{#1}}
\lst@Key{linebackgroundcmd}{\color@block}{\def\lst@linebgrdcmd{#1}}
\newcommand{\lst@linebgrd}{\ifx\lst@linebgrdcolor\empty\else\rlap{\lst@basicstyle\color{-.}\lst@linebgrdcolor{\kern-\dimexpr\lst@linebgrdsep\relax\lst@linebgrdcmd{\lst@linebgrdwidth}{\lst@linebgrdheight}{\lst@linebgrddepth}}}\fi}
\makeatother
\lstdefinelanguage{JSON}{morestring=[b]",morecomment=[l]{//},morekeywords={true,false,null}}
\lstdefinelanguage{YAML}{sensitive=false,morecomment=[l]{\#},morestring=[b]",morekeywords={true,false,yes,no,null}}
\lstdefinestyle{BayesCode}{%
  backgroundcolor=\color{BayesCode},basicstyle=\ttfamily\scriptsize\color{BayesInk},
  commentstyle=\color{BayesMuted},keywordstyle=\bfseries\color{BayesTeal},stringstyle=\color{BayesPlum},
  frame=single,framerule=.35pt,rulecolor=\color{BayesBorder},framesep=4pt,
  breaklines=true,breakatwhitespace=false,columns=fullflexible,keepspaces=true,showstringspaces=false,tabsize=2,
  numbers=left,numberstyle=\tiny\color{BayesMuted},numbersep=6pt,linebackgroundcolor={\BayesLineBackground}}
\newcommand{\BayesHighlightedLines}{}
\makeatletter
\newcommand{\BayesLineBackground}{\color{BayesCode}\def\BayesLineMatch{0}\@for\BayesLineCandidate:=\BayesHighlightedLines\do{\ifnum\value{lstnumber}=\BayesLineCandidate\relax\def\BayesLineMatch{1}\fi}\ifnum\BayesLineMatch=1\color{BayesCodeHighlight}\fi}
\makeatother
\lstnewenvironment{CodeBlock}[2][]{\lstset{style=BayesCode,language=#2,#1}}{}
\lstnewenvironment{HighlightedCodeBlock}[3][]{\gdef\BayesHighlightedLines{#3}\lstset{style=BayesCode,language=#2,#1}}{\gdef\BayesHighlightedLines{}}
\newcommand{\InlineCode}[1]{{\ttfamily\small\color{BayesTeal}#1}}
\newtcolorbox{CodeCallout}[1]{enhanced,arc=2mm,boxrule=.45pt,
  colback=BayesPale,colframe=BayesBorder,borderline west={2.3pt}{0pt}{BayesTeal},left=4.0mm,right=3.4mm,top=2.4mm,bottom=2.4mm,
  fonttitle=\bfseries,coltitle=BayesTeal,title={#1}}
% Keep longer snippets in a local asset file while retaining line-level teaching context.
% \CodeFromFileWithCallout[listing options]{language}{file}{highlighted lines}{title}{explanation}
\newcommand{\CodeFromFileWithCallout}[6][]{%
  \begin{columns}[T,onlytextwidth]
    \begin{column}{.61\textwidth}\begingroup\gdef\BayesHighlightedLines{#4}\lstinputlisting[style=BayesCode,language=#2,numbers=left,#1]{\BayesAssetPath{#3}}\endgroup\end{column}
    \begin{column}{.35\textwidth}\begin{CodeCallout}{#5}#6\end{CodeCallout}\end{column}
  \end{columns}%
}

% Reusable diagram and scientific-plot primitives.
\tikzset{
  bayes/node/.style={rounded corners=2mm,draw=BayesBorder,fill=BayesSurface,very thick,minimum width=2.05cm,minimum height=.72cm,align=center,font=\small\bfseries\color{BayesInk}},
  bayes/data/.style={bayes/node,fill=BayesPale,draw=BayesTeal!42!BayesPale},
  bayes/model/.style={bayes/node,fill=BayesBlue!7!white,draw=BayesBlue!38!white},
  bayes/flow/.style={-{Latex[length=1.8mm]},very thick,draw=BayesSecondary},
  bayes/accent/.style={rounded corners=1.2mm,fill=BayesTeal,text=white,font=\scriptsize\bfseries,inner xsep=2.2mm,inner ysep=1.2mm},
  bayes/measurement/.style={-{Latex[length=1.5mm]}-{Latex[length=1.5mm]},draw=BayesTeal,very thick}
}

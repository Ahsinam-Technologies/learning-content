      \fill[BayesPale] ([xshift=11.55cm]current page.north west) rectangle (current page.south east);
      \draw[BayesBorder,line width=.45pt] ([xshift=12.15cm,yshift=-.78cm]current page.north west) -- ([xshift=12.15cm,yshift=-6.85cm]current page.north west);
      \fill[BayesTeal] ([xshift=12.15cm,yshift=-6.81cm]current page.north west) rectangle ([xshift=15.45cm,yshift=-6.86cm]current page.north west);
      \fill[BayesTeal] ([xshift=13.15cm,yshift=-2.10cm]current page.north west) circle (.08cm);
      \draw[BayesTeal!55!BayesPale,line width=.8pt] ([xshift=14.35cm,yshift=-3.55cm]current page.north west) circle (.35cm);
    \end{tikzpicture}%
    \vspace*{.66cm}\hspace*{.78cm}\BayesStackMark
    \vfill
    \hspace*{.78cm}{\color{BayesTeal}\rule{1.10cm}{2.1pt}}\par\vspace{.30cm}
    \hspace*{.78cm}\begin{minipage}{.65\paperwidth}\raggedright
      {\BayesDisplayFont\fontsize{25}{30}\selectfont\bfseries\color{BayesInk}\inserttitle\par}
      \vspace{.30cm}{\large\color{BayesSecondary}\insertsubtitle\par}
      \vspace{.42cm}{\small\color{BayesTeal}\BayesCourseCode\par}
    \end{minipage}
    \vfill
    \hspace*{.78cm}\vspace*{.66cm}
  \end{beamercolorbox}%
}

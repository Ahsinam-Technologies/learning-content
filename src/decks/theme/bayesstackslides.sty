% Course metadata macros
\newcommand{\BayesCourseCode}{}
\newcommand{\BayesCourseName}{}
\newcommand{\BayesDeckScope}{}
\newcommand{\CourseMetadata}[3]{\gdef\BayesCourseCode{#1}\gdef\BayesCourseName{#2}\gdef\BayesDeckScope{#3}}

% Directory resolution for fragile frames
\newcommand{\BayesAssetRoot}{}
\newcommand{\BayesCaptureAssetRoot}{\xdef\BayesAssetRoot{\currfiledir}}
\newcommand{\BayesAssetPath}[1]{\BayesAssetRoot#1}
\newcommand{\BayesStackWordmark}{{\BayesDisplayFont\fontsize{10.5}{12}\selectfont\bfseries\color{BayesTeal}Bayes\color{BayesDark}Stack}}
\newcommand{\BayesStackMark}{\IfFileExists{bayesstack_logo_black_2048.png}{\raisebox{-.12cm}{\includegraphics[height=.36cm]{bayesstack_logo_black_2048.png}}\hspace{.12cm}}{}\BayesStackWordmark}

% -----------------------------------------------------------------------------
% Elevated Clean Header & Sleek Footer
% -----------------------------------------------------------------------------
\setbeamertemplate{frametitle}{%
  \nointerlineskip%
  \begin{beamercolorbox}[wd=\paperwidth,leftskip=.78cm,rightskip=.78cm]{frametitle}%
    \vspace{.22cm}%
    {\BayesDisplayFont\fontsize{15}{18}\selectfont\bfseries\color{BayesInk}\strut\insertframetitle}\par\vspace{.08cm}%
    \textcolor{BayesTeal}{\rule{1.20cm}{1.8pt}}\textcolor{BayesBorder}{\rule{\dimexpr\linewidth-1.20cm\relax}{.4pt}}\par\vspace{.08cm}%
  \end{beamercolorbox}%
}

\setbeamertemplate{footline}{%
  \leavevmode\hbox{%
    \begin{beamercolorbox}[wd=.62\paperwidth,ht=.36cm,dp=.10cm,leftskip=.78cm]{author in head/foot}%
      \scriptsize\color{BayesMuted}%
      \ifstrempty{\BayesCourseCode}{}{\textbf{\color{BayesSecondary}\BayesCourseCode}\enspace\textbar\enspace}%
      \BayesCourseName%
    \end{beamercolorbox}%
    \begin{beamercolorbox}[wd=.38\paperwidth,ht=.36cm,dp=.10cm,rightskip=.78cm plus1fill]{date in head/foot}%
      \hfill%
      \tcbox[on line,boxsep=0pt,left=4pt,right=4pt,top=1.2pt,bottom=1.2pt,colback=white,colframe=BayesBorder,arc=1.2mm]{%
        \tiny\bfseries\color{BayesSecondary}\insertframenumber\,/\,\inserttotalframenumber%
      }%
      \hspace{.28cm}\BayesStackWordmark%
    \end{beamercolorbox}%
  }\vskip.10cm%
}

% -----------------------------------------------------------------------------
% Title Pages & Section Dividers
% -----------------------------------------------------------------------------
\setbeamercolor{title page}{bg=BayesCanvas}
\setbeamertemplate{title page}{%
  \begin{beamercolorbox}[wd=\paperwidth,ht=\paperheight,sep=0pt]{title page}%
    \begin{tikzpicture}[remember picture,overlay]
      \fill[BayesPale] ([xshift=11.20cm]current page.north west) rectangle (current page.south east);
      \draw[BayesBorder,line width=.5pt] ([xshift=11.85cm,yshift=-.78cm]current page.north west) -- ([xshift=11.85cm,yshift=-6.85cm]current page.north west);
      \fill[BayesTeal] ([xshift=11.85cm,yshift=-6.81cm]current page.north west) rectangle ([xshift=15.45cm,yshift=-6.86cm]current page.north west);
      \fill[BayesTeal] ([xshift=13.00cm,yshift=-2.10cm]current page.north west) circle (.08cm);
      \draw[BayesTeal!45!BayesPale,line width=.8pt] ([xshift=14.20cm,yshift=-3.55cm]current page.north west) circle (.45cm);
      \draw[BayesDeepTeal!25!white,line width=.4pt,dashed] ([xshift=12.50cm,yshift=-5.00cm]current page.north west) circle (.90cm);
    \end{tikzpicture}%
    \vspace*{.66cm}\hspace*{.78cm}\BayesStackMark
    \vfill
    \hspace*{.78cm}{\color{BayesTeal}\rule{1.20cm}{2.4pt}}\par\vspace{.32cm}
    \hspace*{.78cm}\begin{minipage}{.65\paperwidth}\raggedright
      {\BayesDisplayFont\fontsize{26}{31}\selectfont\bfseries\color{BayesInk}\inserttitle\par}
      \vspace{.32cm}{\large\color{BayesSecondary}\insertsubtitle\par}
      \vspace{.42cm}{%
        \tcbox[on line,boxsep=0pt,left=6pt,right=6pt,top=2.5pt,bottom=2.5pt,colback=BayesPale,colframe=BayesTeal,arc=2mm]{%
          \footnotesize\bfseries\color{BayesTeal}\BayesCourseCode%
        }%
      }\par
    \end{minipage}
    \vfill
    \hspace*{.78cm}\vspace*{.66cm}
  \end{beamercolorbox}%
}
\newcommand{\BayesCourseTitleSlide}[2]{\title{#1}\subtitle{#2}\begin{frame}[plain]\titlepage\end{frame}}

\newcommand{\SessionEntry}[3]{\item[]\tcbox[on line,boxsep=0pt,left=3.5pt,right=3.5pt,top=1pt,bottom=1pt,colback=BayesPale,colframe=BayesTeal!40!BayesBorder,arc=1.2mm]{\tiny\bfseries\color{BayesTeal}#1}\hspace{.4em}\textbf{#2}\par\scriptsize\color{BayesSecondary}#3\normalsize\vspace{.10cm}}
\newcommand{\TopicEntry}[3]{\item[]\tcbox[on line,boxsep=0pt,left=3.5pt,right=3.5pt,top=1pt,bottom=1pt,colback=BayesPale,colframe=BayesTeal!40!BayesBorder,arc=1.2mm]{\tiny\bfseries\color{BayesTeal}#1}\hspace{.4em}\textbf{#2}\par\scriptsize\color{BayesSecondary}#3\normalsize\vspace{.10cm}}
\newcommand{\CourseSessionMapSlide}[1]{%
  \begin{frame}{Course Master Roadmap}\footnotesize\begin{enumerate}\setlength{\itemsep}{.04cm}#1\end{enumerate}\vfill\BayesCaption{Integrated modules structured for theoretical rigor and computational implementation.}\end{frame}%
}
\newcommand{\SessionTopicMapSlide}[1]{%
  \begin{frame}{Session Modular Agenda}\footnotesize\begin{enumerate}\setlength{\itemsep}{.04cm}#1\end{enumerate}\vfill\BayesCaption{Topic units sequence in-class lectures, mathematical derivations, and production labs.}\end{frame}%
}

\newcommand{\SessionDivider}[3]{%
  \BayesCaptureAssetRoot
  {\setbeamercolor{background canvas}{bg=BayesDark}%
  \begin{frame}[plain]
    \begin{tikzpicture}[remember picture,overlay]
      \draw[BayesTeal!30!BayesDark,line width=.5pt] ([xshift=2cm]current page.north west) -- ([xshift=14cm]current page.south east);
      \fill[BayesDeepTeal!40!BayesDark] ([xshift=13cm,yshift=-2cm]current page.north west) circle (1.8cm);
    \end{tikzpicture}
    \vspace*{.72cm}\hspace*{.78cm}{%
      \tcbox[on line,boxsep=0pt,left=6pt,right=6pt,top=2.5pt,bottom=2.5pt,colback=BayesDeepTeal,colframe=BayesTeal,arc=2mm]{%
        \footnotesize\bfseries\color{white}SESSION\enspace#1%
      }%
    }\par
    \vfill\hspace*{.78cm}\begin{minipage}{.78\paperwidth}\raggedright
      {\BayesDisplayFont\fontsize{28}{34}\selectfont\bfseries\color{white}#2\par}\vspace{.26cm}
      {\large\color{BayesBorder}#3\par}
    \end{minipage}\vfill
    \hspace*{.78cm}{\scriptsize\color{BayesPale}\BayesCourseCode\ifstrempty{\BayesCourseName}{}{\enspace\textbar\enspace\BayesCourseName}}\vspace*{.58cm}
  \end{frame}}%
}

\newcommand{\TopicDivider}[3]{%
  \BayesCaptureAssetRoot
  {\setbeamercolor{background canvas}{bg=BayesPale}%
  \begin{frame}[plain]
    \begin{tikzpicture}[remember picture,overlay]
      \fill[white] ([xshift=10cm]current page.north west) rectangle (current page.south east);
      \draw[BayesBorder,line width=.5pt] ([xshift=10cm]current page.north west) -- ([xshift=10cm]current page.south east);
    \end{tikzpicture}
    \vspace*{.82cm}\hspace*{.78cm}{%
      \tcbox[on line,boxsep=0pt,left=6pt,right=6pt,top=2.5pt,bottom=2.5pt,colback=BayesTeal,colframe=BayesDeepTeal,arc=2mm]{%
        \footnotesize\bfseries\color{white}TOPIC\enspace#1%
      }%
    }\par
    \vfill\hspace*{.78cm}\begin{minipage}{.74\paperwidth}\raggedright
      {\BayesDisplayFont\fontsize{27}{32}\selectfont\bfseries\color{BayesInk}#2\par}\vspace{.24cm}
      {\large\color{BayesSecondary}#3\par}
    \end{minipage}\vfill
    \hspace*{.78cm}{\color{BayesTeal}\rule{1.20cm}{2.2pt}}\vspace*{.68cm}
  \end{frame}}%
}

% Subfiles standalone compatibility
\newcommand{\SessionStandaloneTitle}[3]{%
  \ifSubfilesClassLoaded{\title{#2}\subtitle{#3}\gdef\BayesDeckScope{Session #1}\begin{frame}[plain]\titlepage\end{frame}}{}%
}
\newcommand{\TopicStandaloneTitle}[3]{%
  \ifSubfilesClassLoaded{\title{#2}\subtitle{#3}\gdef\BayesDeckScope{Topic #1}\begin{frame}[plain]\titlepage\end{frame}}{}%
}


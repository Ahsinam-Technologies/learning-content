% Capture the directory of a shared content fragment before Beamer serialises a
% fragile frame. This lets local assets retain the same short path in every build.
\newcommand{\BayesAssetRoot}{}
\newcommand{\BayesCaptureAssetRoot}{\xdef\BayesAssetRoot{\currfiledir}}
\newcommand{\BayesAssetPath}[1]{\BayesAssetRoot#1}
\newcommand{\BayesStackWordmark}{{\fontsize{13}{14}\selectfont\bfseries\textcolor{BayesTeal}{BayesStack}}}
\newcommand{\BayesStackMark}{\IfFileExists{bayesstack_logo_black_2048.png}{\raisebox{-.13cm}{\includegraphics[height=.38cm]{bayesstack_logo_black_2048.png}}\hspace{.13cm}}{}\BayesStackWordmark}

\setbeamertemplate{frametitle}{%
  \vspace{.16cm}\makebox[\textwidth][r]{\scriptsize\color{BayesMuted}\BayesCourseCode\ifstrempty{\BayesDeckScope}{}{\enspace/\enspace\BayesDeckScope}}\par
  \vspace{.03cm}\strut\insertframetitle\par
  \vspace{.10cm}\textcolor{BayesTeal}{\rule{.90cm}{1.35pt}}\textcolor{BayesBorder}{\rule{\dimexpr\textwidth-.90cm\relax}{.35pt}}\vspace{-.04cm}
